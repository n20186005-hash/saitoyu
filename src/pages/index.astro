---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MemoryCardStudio from '@/components/MemoryCardStudio.astro';
import Weather from '@/components/Weather.astro';

const mapUrl = 'https://www.google.com/maps/place/Sait%C5%8D+Yu/data=!4m7!3m6!1s0x60188e7f59a32057:0xe076bfad049e7598!8m2!3d35.729335!4d139.773033!16s%2Fg%2F11bw2j17zz';
const mapEmbedSrc = 'https://www.google.com/maps?q=35.729335,139.773033&z=16&output=embed';
const govtTourismUrl = 'https://www.gotokyo.org/';
const rating = { score: 4.4, reviews: 1685 };

const services = [
  { icon: '🚻', title: 'トイレ・更衣', copy: '銭湯内に更衣室・洗い場・浴槽があります。駅構内や周辺にも公衆トイレがあり、小さな子連れでも安心です。' },
  { icon: '🅿️', title: '駐車場', copy: '銭湯専用の駐車場は台数が限られています。周辺には時間貸しの駐車場（コインパーキング）が複数あります。' },
  { icon: '🍜', title: '飲食', copy: '駅前や繊維街周辺に食堂・立ち食いそば・カフェ・ベーカリーなど、気軽に入れる店がそろいます。' },
  { icon: '🛏️', title: '宿泊', copy: '日暮里・西日暮里・千駄木周辺にビジネスホテルやカプセル、旅館など滞在の拠点がそろいます。' },
  { icon: '🏪', title: '商超', copy: '駅近くにコンビニエンスストアやスーパーがあり、飲み物や着替えの補充に便利です。' },
  { icon: '🔌', title: '充電・給油', copy: '周辺には電気自動車の充電設備（商業施設や駐車場の併設など）やガソリンスタンドがあります。' },
  { icon: '🧳', title: 'コインロッカー', copy: '日暮里駅にコインロッカーがあり、手ぶらで湯めぐりを楽しめます。' },
  { icon: '🧴', title: '備品', copy: 'タオルやシャンプー等の備品は銭湯で販売・レンタルがあり、手ぶらでも入浴できます。' },
];

const seasons = [
  { season: '春（3〜5月）', climate: '昼は暖かい日もありますが、朝晩は肌寒いことがあります。桜の時期は人出も増えます。', enjoy: '湯上がりに谷中の桜並木や夕やけだんだんを散歩。ぬるめの炭酸泉でほどけます。', note: '上着を。混雑時は時間帯をずらすとゆったり。' },
  { season: '夏（6〜8月）', climate: '高温多湿。にわか雨の日も。日照時間が長く、夜型の過ごし方も。', enjoy: '高濃度炭酸泉と水風呂の往復が極楽。シルキーバスで汗を流します。', note: '熱中症予防にこまめな水分補給。タオルは多めに。' },
  { season: '秋（9〜11月）', climate: '過ごしやすい日が続き、行楽に最適。朝夕涼しくなります。', enjoy: '谷中銀座や朝倉彫塑館を巡り、1日の終わりに湯でほどくコースが鉄板。', note: '薄手の羽織を。紅葉の時期は散策が特にいそがしい。' },
  { season: '冬（12〜2月）', climate: '本格的な寒さ。空気が乾燥し、湯冷めが気になる季節です。', enjoy: '露天岩風呂は一番のごちそう。あつ湯と水風呂で体が目覚めます。', note: '上がってすぐに上着を。乾燥対策に入浴後の保湿を。' },
];

const plans = [
  { icon: '👨‍👩‍👧', title: '親子家族', copy: 'シルキーバスやぬるめの炭酸泉なら小さい子も一緒に。浴室の壁画を探すゲームも楽しい。周辺の公園でひと休みをはさみ、無理のないペースで。' },
  { icon: '📷', title: '写真・散歩', copy: '藍色ののれんと路地、谷中銀座、夕やけだんだん、朝倉彫塑館。朝の光と夕景の両方を狙うなら、湯はどちらかの前後に。' },
  { icon: '🦽', title: '低体力・バリアフリー', copy: '日暮里駅周辺は比較的フラット。銭湯は平屋ですが、脱衣所等に段差がある場合も。無理なく短時間で、受付で相談を。' },
];

const bathFeatures = [
  {
    number: '01',
    name: '高濃度炭酸泉',
    copy: '細かな気泡に包まれながら、ぬるめのお湯でゆっくり。長く浸かりたい日にうれしい人気の浴槽です。',
  },
  {
    number: '02',
    name: '露天岩風呂',
    copy: '街なかにいながら、外気を感じられる小さな余白。湯気と夜風が一日の速度を静かに落としてくれます。',
  },
  {
    number: '03',
    name: 'シルキーバス',
    copy: '微細な泡で白く見える、なめらかな湯。やさしい肌あたりの軟水とともに楽しめます。',
  },
  {
    number: '04',
    name: 'あつ湯・水風呂',
    copy: 'しっかり温まりたい人向けのあつ湯と、すっきり整える水風呂。体調に合わせて無理なくどうぞ。',
  },
];

const foods = [
  {
    number: '01',
    name: '馬賊 日暮里店',
    type: '手打拉麺・担々麺',
    distance: '日暮里駅前 / 徒歩約4分',
    copy: '店頭で打つ力強い麺が主役。湯上がりに、もちもちの麺と濃いめの一杯を楽しみたい日に。',
    tag: 'しっかり食べる',
  },
  {
    number: '02',
    name: '羽二重団子 本店',
    type: '団子・甘味',
    distance: '東日暮里 / 徒歩約8分',
    copy: '文政二年創業と伝わる日暮里の甘味処。きめ細かな団子で、散歩の途中に静かなひと休みを。',
    tag: '日暮里らしい甘味',
  },
  {
    number: '03',
    name: '一由そば',
    type: '立ち食いそば',
    distance: '西日暮里方面 / 徒歩約13分',
    copy: '気軽で早く、天ぷらの選択肢も豊富。朝風呂ではなくても、遅い時間の腹ごしらえに頼れる一軒。',
    tag: '気軽・24時間営業',
  },
  {
    number: '04',
    name: '談話室 ニュートーキョー',
    type: '純喫茶・洋食',
    distance: '日暮里駅前 / 徒歩約4分',
    copy: '大きな窓とレトロな空気が残る駅前喫茶。入浴前の待ち合わせや、湯上がりの余韻に向いています。',
    tag: 'レトロ喫茶',
  },
];

const nearbySpots = [
  {
    name: '日暮里繊維街',
    time: '徒歩約8〜12分',
    copy: '生地、ボタン、革、手芸用品が集まる約1kmの通り。ものづくり好きなら、入浴前に時間を多めに。',
  },
  {
    name: '夕やけだんだん',
    time: '徒歩約10分',
    copy: '谷中銀座へ下る階段。名前のとおり夕景が似合い、下町散歩の始まりと終わりをつなぎます。',
  },
  {
    name: '谷中銀座商店街',
    time: '徒歩約12分',
    copy: '惣菜、甘味、雑貨が並ぶ昔ながらの商店街。食べ歩きは、銭湯に入る前の軽めがおすすめです。',
  },
  {
    name: '下御隠殿橋',
    time: '徒歩約6分',
    copy: 'JRや新幹線が行き交う線路を見下ろせる橋。短時間でも日暮里らしい鉄道風景に出会えます。',
  },
  {
    name: '朝倉彫塑館',
    time: '徒歩約10分',
    copy: '彫刻家・朝倉文夫の住居兼アトリエ。建築、中庭、彫刻を静かに巡りたい日に組み合わせたい場所です。',
  },
  {
    name: '諏方神社',
    time: '徒歩約14分',
    copy: '西日暮里の高台に鎮座する地域の鎮守。境内から線路側を望み、町の起伏を感じる散歩へ。',
  },
];

const faqs = [
  {
    question: '手ぶらでも入れますか？',
    answer: 'シャンプー・ボディソープの備え付けがあり、タオルは貸出（40円）とバスタオル貸出（60円）、オリジナルタオル販売（400円）があります。湯上がりの生ビール（中濃度・600円）も。入浴料のほか、クレジットカード・交通IC・QR決済にも対応しています。詳細は当日現地でご確認ください。',
  },
  {
    question: 'サウナはありますか？',
    answer: '斉藤湯にサウナはありません。東京銭湯（1010.or.jp）の公式施設情報にもサウナの記載はなく、高濃度炭酸泉、露天岩風呂、シルキーバス、あつ湯、水風呂など、浴槽の違いを楽しむ銭湯です。施設の変更がないかは、当日の公式情報でご確認ください。',
  },
  {
    question: '大きな荷物を持って行けますか？',
    answer: 'ランナー向けの荷物預かりサービスが案内されています。ただし、スーツケースなど大型荷物の対応可否や受付条件は事前に電話で確認すると安心です。',
  },
  {
    question: '子どもと一緒に利用できますか？',
    answer: '家族でも利用できる地域の銭湯です。浴室では走らない、湯船にタオルを入れないなど、周囲に配慮して楽しみましょう。',
  },
  {
    question: '営業時間は何時までですか？',
    answer: '14:00〜23:00、金曜は定休日です。営業時間は変更される場合があるため、遅い時間に向かう際は当日の公式情報でご確認ください。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '日本', item: 'https://saitoyu.com/' },
    { '@type': 'ListItem', position: 2, name: '東京都', item: 'https://saitoyu.com/' },
    { '@type': 'ListItem', position: 3, name: '荒川区', item: 'https://saitoyu.com/' },
    { '@type': 'ListItem', position: 4, name: '日暮里 斉藤湯', item: 'https://saitoyu.com/' },
  ],
};
---

<BaseLayout>
  <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-indigo/88 text-white backdrop-blur-xl">
    <div class="container-shell flex h-[72px] items-center justify-between gap-6">
      <a href="#top" class="group flex items-center gap-3" aria-label="ページ先頭へ">
        <span class="grid size-9 place-items-center rounded-lg bg-paper text-lg font-bold text-copper transition group-hover:rotate-3">ゆ</span>
        <span class="font-serif text-lg font-semibold tracking-[0.12em]">日暮里 斉藤湯</span>
      </a>

      <nav class="hidden items-center gap-7 text-[0.76rem] font-bold tracking-[0.08em] text-white/72 lg:flex" aria-label="メインナビゲーション">
        <a class="transition hover:text-white" href="#weather">天気</a>
        <a class="transition hover:text-white" href="#baths">お風呂</a>
        <a class="transition hover:text-white" href="#guide">利用案内</a>
        <a class="transition hover:text-white" href="#food">周辺グルメ</a>
        <a class="transition hover:text-white" href="#access">交通</a>
        <a class="transition hover:text-white" href="#nearby">周辺スポット</a>
        <a class="rounded-full border border-white/22 px-4 py-2.5 text-white transition hover:bg-white hover:text-indigo" href="#memory-card">記念カードを作る</a>
      </nav>

      <details class="relative lg:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-white/20" aria-label="メニューを開く">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        </summary>
        <nav class="absolute right-0 mt-3 grid w-56 gap-1 rounded-2xl border border-white/10 bg-indigo-deep p-3 text-sm shadow-2xl" aria-label="モバイルナビゲーション">
          <a class="rounded-xl px-4 py-3 hover:bg-white/8" href="#baths">お風呂</a>
          <a class="rounded-xl px-4 py-3 hover:bg-white/8" href="#guide">利用案内</a>
          <a class="rounded-xl px-4 py-3 hover:bg-white/8" href="#food">周辺グルメ</a>
          <a class="rounded-xl px-4 py-3 hover:bg-white/8" href="#access">詳しいアクセス</a>
          <a class="rounded-xl px-4 py-3 hover:bg-white/8" href="#nearby">周辺スポット</a>
          <a class="rounded-xl bg-copper px-4 py-3 font-bold" href="#memory-card">記念カードを作る</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    <span id="attraction" class="sr-only" aria-hidden="true"></span>
    <section id="top" class="relative min-h-[760px] overflow-hidden bg-indigo pt-[72px] text-white lg:min-h-screen">
      <div class="absolute inset-0">
        <img class="h-full w-full object-cover object-center" src="/images/saito-yu-exterior.webp" alt="日暮里 斉藤湯（斉藤湯）の入口と藍色ののれん - 東京都日暮里" width="640" height="480" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(9,25,45,.95)_0%,rgba(9,25,45,.78)_42%,rgba(9,25,45,.28)_75%,rgba(9,25,45,.55)_100%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(9,25,45,.82)_0%,transparent_46%)]"></div>
      </div>

      <div class="washi-noise relative z-10 flex min-h-[688px] items-end lg:min-h-[calc(100vh-72px)]">
        <div class="container-shell grid items-end gap-10 pb-12 pt-24 lg:grid-cols-[1fr_300px] lg:pb-16">
          <div class="reveal max-w-4xl">
            <div class="mb-7 flex flex-wrap items-center gap-3 text-[0.68rem] font-extrabold tracking-[0.18em] text-white/65">
              <span class="rounded-full border border-white/22 px-3 py-2">JR日暮里駅 徒歩約3分</span>
              <span class="rounded-full border border-white/22 px-3 py-2">金曜定休</span>
              <span class="rounded-full border border-copper/45 px-3 py-2 text-wood">非公式ガイド</span>
            </div>
            <h1 class="mt-2 font-serif text-[clamp(3rem,9vw,7.4rem)] font-semibold leading-[0.96] tracking-[-0.05em]">
              日暮里 斉藤湯
            </h1>
            <p class="mt-4 font-serif text-lg tracking-[0.16em] text-wood sm:text-2xl">にっぽり さいとうゆ｜日暮里駅近くの銭湯ガイド</p>
            <p class="mt-8 max-w-2xl text-base leading-8 text-white/70 sm:text-lg">
              軟水のやさしさ、高濃度炭酸泉の細かな泡、露天岩風呂を抜ける夜風。旅の予定を一度ほどいて、東京の「いつものお風呂」に入る時間です。
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
              <span class="inline-flex items-center gap-2 rounded-full border border-white/22 px-4 py-2 text-sm font-bold text-white">
                <svg class="size-4 text-wood" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 2.9 6.1 6.6.9-4.8 4.6 1.2 6.6L12 18.6 6.1 21.2l1.2-6.6L2.5 9l6.6-.9L12 2Z"/></svg>
                {rating.score}
                <span class="font-normal text-white/65">· Google {rating.reviews.toLocaleString('ja-JP')}件の評価</span>
              </span>
            </div>
            <p class="mt-2 text-xs leading-5 text-white/55">
              評価・口コミ数は Google マップ（Google Maps）のユーザー評価と同じものを 2026 年 10 月に同期 · <a class="underline underline-offset-2 transition hover:text-white" href={mapUrl} target="_blank" rel="noopener noreferrer">Google マップですべての評価を見る↗</a>
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#guide" class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-paper px-6 font-bold text-indigo transition hover:-translate-y-0.5 hover:bg-white">
                はじめての利用案内
                <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-white/25 bg-white/8 px-6 font-bold text-white backdrop-blur transition hover:bg-white/14">
                地図を開く
                <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" stroke="currentColor" stroke-width="1.7"/></svg>
              </a>
            </div>
          </div>

          <div class="hidden justify-self-end lg:block">
            <div class="relative h-40 w-28 text-white/60" aria-hidden="true">
              <svg class="absolute inset-0 h-full w-full" viewBox="0 0 112 160" fill="none">
                <path class="steam-line" d="M32 135c-16-24 16-34 1-56-13-20 11-31 4-50" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                <path class="steam-line" d="M58 141c-15-21 15-37 1-59-13-20 12-33 5-57" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
                <path class="steam-line" d="M83 135c-13-20 11-32 0-51-12-20 8-30 3-49" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <div class="absolute bottom-0 left-1/2 z-20 hidden -translate-x-1/2 translate-y-1/2 lg:block">
        <a href="#story" class="grid size-20 place-items-center rounded-full border-[10px] border-indigo bg-copper text-white shadow-2xl transition hover:scale-105" aria-label="次のセクションへ">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </section>

    <Weather />

    <section id="story" class="section-pad overflow-hidden">
      <div class="container-shell">
        <div class="grid items-center gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-20">
          <div class="relative">
            <div class="absolute -left-14 -top-14 -z-10 size-64 rounded-full border border-aqua/35"></div>
            <div class="relative overflow-hidden rounded-[2rem] shadow-[0_30px_90px_rgba(13,29,50,.16)]">
              <img class="aspect-[4/3] w-full object-cover" src="/images/saito-yu-bath.webp" alt="日暮里 斉藤湯（斉藤湯）の明るい浴室 - 東京都日暮里" width="680" height="452" loading="lazy" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-indigo/85 to-transparent p-7 pt-24 text-white">
                <p class="font-serif text-2xl">清潔さと、下町の親しみ。</p>
              </div>
            </div>
            <div class="absolute -bottom-7 -right-3 rounded-2xl bg-paper px-6 py-5 shadow-xl sm:right-8">
              <p class="text-4xl font-light text-copper">徒歩<span class="ml-1 font-serif">3分</span></p>
            </div>
          </div>

          <div>
            <h2 class="section-title">駅前の速さから、湯船の時間へ。</h2>
            <div class="mt-8 space-y-6 text-base leading-8 text-ink/72">
              <p>日暮里 斉藤湯（斉藤湯 / Saitō Yu）は、日暮里の中心にある公衆浴場です。JR・京成の日暮里駅から歩いて約3分で、空港や都心からアクセスしやすい場所にありながら、扉の向こうには地域の日常が続いています。</p>
              <p>館内で使う水は、肌あたりのやわらかな軟水と案内されています。高濃度炭酸泉、シルキーバス、露天岩風呂、あつ湯、水風呂など、温度と感触の違いを行き来しながら、自分のペースを見つけられる銭湯です。</p>
