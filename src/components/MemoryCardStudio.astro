<section id="memory-card" class="section-pad overflow-hidden bg-indigo text-white">
  <div class="container-shell">
    <div class="grid items-start gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-18">
      <div class="lg:sticky lg:top-28">
        <h2 class="section-title !max-w-[9ch] !text-white">湯上がりの一枚を、旅の記憶に。</h2>
        <p class="mt-7 max-w-xl text-base leading-8 text-white/70">
          撮影した写真やアルバムの一枚を使って、斉藤湯らしい藍色の記念カードを作れます。写真、文字、完成画像はブラウザ内だけで処理されます。
        </p>

        <div class="mt-8 rounded-2xl border border-white/14 bg-white/7 p-5">
          <div class="flex items-start gap-3">
            <svg class="mt-0.5 size-5 shrink-0 text-aqua" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3 5 6v5c0 4.7 2.8 8.3 7 10 4.2-1.7 7-5.3 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7"/>
              <path d="m9.2 12 1.8 1.8 3.9-4.1" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <p class="font-bold">写真はお使いの端末にのみ保存されます</p>
              <p class="mt-1 text-sm leading-6 text-white/62">アップロードもサーバー保存も行いません。ページを閉じると編集中の内容は消去されます。</p>
            </div>
          </div>
        </div>

        <ol class="mt-8 space-y-4 text-sm text-white/72">
          <li class="flex gap-4"><span class="grid size-7 shrink-0 place-items-center rounded-full border border-white/25 font-mono text-xs">1</span><span class="pt-1">写真を撮る、セルフィーを撮る、またはアルバムから選ぶ</span></li>
          <li class="flex gap-4"><span class="grid size-7 shrink-0 place-items-center rounded-full border border-white/25 font-mono text-xs">2</span><span class="pt-1">サイズ、雰囲気、文字を整える</span></li>
          <li class="flex gap-4"><span class="grid size-7 shrink-0 place-items-center rounded-full border border-white/25 font-mono text-xs">3</span><span class="pt-1">PNG画像として端末へダウンロード</span></li>
        </ol>
      </div>

      <div class="rounded-[2rem] border border-white/12 bg-paper-light p-4 text-ink shadow-[0_35px_100px_rgba(0,0,0,.25)] sm:p-7">
        <div class="grid gap-7 xl:grid-cols-[0.94fr_1.06fr]">
          <div class="order-2 xl:order-1">
            <div class="space-y-7">
              <fieldset>
                <legend class="text-sm font-extrabold tracking-[0.12em] text-indigo">写真を選ぶ</legend>
                <input id="memory-file" class="sr-only" type="file" accept="image/*" />
                <div class="mt-3 grid grid-cols-3 gap-2">
                  <button data-photo-source="environment" type="button" class="memory-source-btn">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8.5h3l1.5-2h7l1.5 2h3v10H4v-10Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="13.5" r="3.2" stroke="currentColor" stroke-width="1.6"/></svg>
                    <span>写真を撮る</span>
                  </button>
                  <button data-photo-source="user" type="button" class="memory-source-btn">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="9" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M6.5 19c.8-3.1 2.7-4.7 5.5-4.7s4.7 1.6 5.5 4.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                    <span>セルフィー</span>
                  </button>
                  <button data-photo-source="album" type="button" class="memory-source-btn">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="m7 16 3.3-3.6 2.7 2.5 2.4-2.3L19 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="15.8" cy="9.2" r="1.2" fill="currentColor"/></svg>
                    <span>アルバム</span>
                  </button>
                </div>
                <p id="memory-file-name" class="mt-2 min-h-5 text-xs leading-5 text-ink/55" aria-live="polite">写真を選ぶと、ここにファイル名が表示されます。</p>
              </fieldset>

              <fieldset>
                <legend class="text-sm font-extrabold tracking-[0.12em] text-indigo">カードサイズ</legend>
                <div class="mt-3 grid grid-cols-3 gap-2">
                  <label class="memory-choice-card">
                    <input class="sr-only" type="radio" name="memory-size" value="square" checked />
                    <span class="aspect-square w-5 rounded-sm border-2 border-current"></span>
                    <span>1:1</span>
                  </label>
                  <label class="memory-choice-card">
                    <input class="sr-only" type="radio" name="memory-size" value="postcard" />
                    <span class="h-7 w-5 rounded-sm border-2 border-current"></span>
                    <span>はがき縦</span>
                  </label>
                  <label class="memory-choice-card">
                    <input class="sr-only" type="radio" name="memory-size" value="story" />
                    <span class="h-8 w-4.5 rounded-sm border-2 border-current"></span>
                    <span>9:16</span>
                  </label>
                </div>
              </fieldset>

              <div>
                <label class="text-sm font-extrabold tracking-[0.12em] text-indigo" for="memory-style">雰囲気</label>
                <select id="memory-style" class="memory-input mt-3 w-full">
                  <option value="noren">藍のれん</option>
                  <option value="steam">湯けむり</option>
                  <option value="sunset">谷中の夕暮れ</option>
                  <option value="tile">銭湯タイル</option>
                </select>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <label class="text-sm font-extrabold tracking-[0.12em] text-indigo" for="memory-title">スポット名</label>
                  <input id="memory-title" class="memory-input mt-3 w-full" type="text" maxlength="24" value="日暮里 斉藤湯" />
                </div>
                <div>
                  <label class="text-sm font-extrabold tracking-[0.12em] text-indigo" for="memory-date">日付</label>
                  <input id="memory-date" class="memory-input mt-3 w-full" type="date" />
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                <div>
                  <div class="flex items-center justify-between">
                    <label class="text-sm font-extrabold tracking-[0.12em] text-indigo" for="memory-zoom">写真の拡大</label>
                    <output id="memory-zoom-value" class="text-xs text-ink/55">100%</output>
                  </div>
                  <input id="memory-zoom" class="memory-range mt-3 w-full" type="range" min="100" max="180" value="100" />
                </div>
                <div>
                  <div class="flex items-center justify-between">
                    <label class="text-sm font-extrabold tracking-[0.12em] text-indigo" for="memory-offset">上下位置</label>
                    <output id="memory-offset-value" class="text-xs text-ink/55">中央</output>
                  </div>
                  <input id="memory-offset" class="memory-range mt-3 w-full" type="range" min="-35" max="35" value="0" />
                </div>
              </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <button id="memory-download" class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full bg-copper px-5 font-bold text-white shadow-lg shadow-copper/20 transition hover:-translate-y-0.5 hover:bg-copper-dark" type="button">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                PNGを保存
              </button>
              <button id="memory-reset" class="inline-flex min-h-12 items-center justify-center rounded-full border border-indigo/15 px-5 font-bold text-indigo transition hover:bg-indigo/5" type="button">リセット</button>
            </div>
            <p id="memory-status" class="mt-3 min-h-5 text-center text-xs leading-5 text-ink/55" aria-live="polite">写真を選ばなくても、テンプレートを保存できます。</p>
          </div>

          <div class="order-1 xl:order-2">
            <div class="rounded-[1.6rem] bg-[#e8e1d5] p-3 shadow-inner sm:p-4">
              <canvas id="memory-canvas" class="mx-auto block h-auto max-h-[640px] w-full rounded-xl bg-white shadow-[0_18px_55px_rgba(13,29,50,.16)]" width="1080" height="1080" aria-label="記念カードのプレビュー"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .memory-source-btn {
    display: flex;
    min-height: 5.4rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid rgb(20 43 74 / 0.13);
    border-radius: 1rem;
    background: white;
    color: rgb(20 43 74 / 0.82);
    font-size: 0.73rem;
    font-weight: 700;
    transition: 160ms ease;
  }

  .memory-source-btn:hover {
    transform: translateY(-2px);
    border-color: rgb(185 95 64 / 0.35);
    color: var(--color-copper-dark);
    box-shadow: 0 10px 28px rgb(13 29 50 / 0.08);
  }

  .memory-source-btn svg {
    width: 1.55rem;
    height: 1.55rem;
  }

  .memory-choice-card {
    display: flex;
    min-height: 4.65rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid rgb(20 43 74 / 0.13);
    border-radius: 1rem;
    background: white;
    color: rgb(20 43 74 / 0.62);
    font-size: 0.75rem;
    font-weight: 800;
    transition: 160ms ease;
  }

  .memory-choice-card:has(input:checked) {
    border-color: var(--color-copper);
    background: rgb(185 95 64 / 0.07);
    color: var(--color-copper-dark);
    box-shadow: 0 0 0 1px rgb(185 95 64 / 0.12);
  }

  .memory-input {
    min-height: 3rem;
    border: 1px solid rgb(20 43 74 / 0.13);
    border-radius: 0.85rem;
    background: white;
    padding: 0.65rem 0.85rem;
    color: var(--color-ink);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .memory-input:focus {
    border-color: rgb(185 95 64 / 0.55);
    box-shadow: 0 0 0 4px rgb(185 95 64 / 0.1);
    outline: none;
  }

  .memory-range {
    accent-color: var(--color-copper);
  }
</style>

<script>
  import { initMemoryCardStudio } from '@/scripts/memory-card';
  initMemoryCardStudio();
</script>
